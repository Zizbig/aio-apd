FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    unzip \
    unrar-free \
    tar \
    wget \
    gcc \
    git \
    build-essential \
    cargo \
    rustc \
    python3-dev \
    && wget -O /usr/local/bin/wgcf https://github.com/ViRb3/wgcf/releases/download/v2.2.22/wgcf_2.2.22_linux_amd64 \
    && chmod +x /usr/local/bin/wgcf \
    && wget -O /tmp/wireproxy.tar.gz https://github.com/octeep/wireproxy/releases/download/v1.0.7/wireproxy_linux_amd64.tar.gz \
    && tar -xzf /tmp/wireproxy.tar.gz -C /usr/local/bin/ wireproxy \
    && chmod +x /usr/local/bin/wireproxy \
    && rm /tmp/wireproxy.tar.gz \
    && rm -rf /var/lib/apt/lists/*

# Change working directory to /app
WORKDIR /app

# Copy all source files
COPY . /app

# Unzip any zip files if present, flatten nested folders, and verify setup
RUN printf "%s\n" \
"import os, glob, zipfile, shutil" \
"zips = glob.glob('/app/*.zip')" \
"for z in zips:" \
"    print(f'📦 Extracting {z}...')" \
"    with zipfile.ZipFile(z, 'r') as zf: zf.extractall('/app')" \
"    os.remove(z)" \
"for entry in os.listdir('/app'):" \
"    ep = os.path.join('/app', entry)" \
"    if os.path.isdir(ep) and entry not in ['.git', 'autol', 'srcv6', 'backend']:" \
"        contents = os.listdir(ep)" \
"        if any(c in ['autol', 'srcv6', 'backend', 'start.sh'] for c in contents):" \
"            print(f'📂 Flattening nested folder: {entry}')" \
"            for c in contents:" \
"                src, dst = os.path.join(ep, c), os.path.join('/app', c)" \
"                if os.path.exists(dst):" \
"                    if os.path.isdir(dst): shutil.rmtree(dst)" \
"                    else: os.remove(dst)" \
"                shutil.move(src, dst)" \
"            shutil.rmtree(ep)" \
"errors = []" \
"if not any(os.path.isdir(os.path.join('/app', d)) for d in ['srcv6', 'autol']):" \
"    errors.append('Neither srcv6 nor autol directory was found. You must deploy at least one bot.')" \
"if not os.path.isfile('/app/start.sh'):" \
"    errors.append('start.sh is missing')" \
"if errors:" \
"    print('❌ Verification failed:')" \
"    for e in errors: print(f'  - {e}')" \
"    exit(1)" \
"else:" \
"    print('✅ Verification successful!')" \
> /app/verify_setup.py && python3 /app/verify_setup.py && rm /app/verify_setup.py

# Ensure start.sh has execute permissions
RUN chmod +x start.sh


# Install dependencies from compiled requirements.txt
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r /app/requirements.txt

# Run start.sh to launch the services
CMD ["bash", "start.sh"]
