# ==============================================================================
# BASE DOCKER IMAGE SPECIFICATION (Dockerfile.mybase)
# ==============================================================================
# NOTE: This file defines the pre-built BASE Docker image (e.g., ghcr.io/zizbig/aio-apd-base).
# The main application Dockerfile pulls this base image and handles application code execution.
# DO NOT add application zip extraction, nested folder flattening, or code unpacking scripts here.
# Keep this base image focused purely on system tools, network proxies (wgcf, wireproxy),
# build compilers (cargo, gcc, git), and globally pre-installed Python requirements.
# ==============================================================================

FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PORT=7860 \
    TZ=Asia/Kolkata

ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies & network binaries
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    tar \
    wget \
    gcc \
    git \
    build-essential \
    cargo \
    rustc \
    chromium \
    xvfb \
    python3-dev \
    && wget -O /usr/local/bin/wgcf https://github.com/ViRb3/wgcf/releases/download/v2.2.22/wgcf_2.2.22_linux_amd64 \
    && chmod +x /usr/local/bin/wgcf \
    && wget -O /tmp/wireproxy.tar.gz https://github.com/octeep/wireproxy/releases/download/v1.0.7/wireproxy_linux_amd64.tar.gz \
    && tar -xzf /tmp/wireproxy.tar.gz -C /usr/local/bin/ wireproxy \
    && chmod +x /usr/local/bin/wireproxy \
    && rm /tmp/wireproxy.tar.gz \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install them globally into the base image
COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r /tmp/requirements.txt && \
    rm /tmp/requirements.txt
